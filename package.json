{
  "name": "linkedin-job-search-ts",
  "version": "1.0.0",
  "description": "A TypeScript Node.js application to search LinkedIn jobs with filters and CSV export.",
  "main": "dist/server.js",
  "scripts": {
    "build:server": "tsc",
    "build:client": "cd client && npm run build",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server.js",
    "dev:server": "tsc --watch & nodemon dist/server.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\""
  },
  "keywords": [
    "linkedin",
    "jobs",
    "vue.js",
    "angular",
    "node.js",
    "typescript",
    "express",
    "csv"
  ],
  "author": "Sam",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.14.0",
    "express": "^4.19.2",
    "html-entities": "^2.6.0",
    "linkedin-jobs-api": "^1.0.1",
    "open": "^10.1.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.4",
    "typescript": "^5.5.3"
  }
}
